[Unit]
Description=authd Identity and OIDC Service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=_authd
Group=_authd
WorkingDirectory=/var/authd
EnvironmentFile=/etc/authd/authd.env
ExecStart=/usr/local/bin/authd
Restart=on-failure
RestartSec=5
UMask=0077

# A dedicated writable runtime path under ProtectSystem=strict. 0711 grants
# traversal, not listing/write access; the socket's 0600/0660 mode gates connect.
RuntimeDirectory=authd
RuntimeDirectoryMode=0711
RuntimeDirectoryPreserve=yes
ReadWritePaths=/run/authd
TimeoutStopSec=15s

# authd requires network access and read access to its root-managed runtime
# configuration. Durable state lives in PostgreSQL; only /run/authd is writable
# for the optional Unix listener. /etc, /usr and its working directory stay read-only.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
