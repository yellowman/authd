# authd runtime environment
#
# This file is accepted by the OpenBSD rc.d service and Linux systemd unit.
# Keep values on one line. The installed service uses /etc/authd/authd.env.
# Do not place the migration-owner PostgreSQL credential here.
#
# The native installer creates missing env/master-key files on first install.
# Re-running it for an upgrade preserves the active env, pgpass, and master key
# while replacing the binary, documentation, examples, and service definition.
# Database migrations remain an explicit operator step using authd_owner.

# Deployment identity. HTTPS is required unless AUTHD_DEVELOPMENT=true.
AUTHD_ISSUER='https://auth.example.com'
# Existing TCP deployments keep this value. For a Unix socket replace it with
# unix:/run/authd/authd.sock (Linux) or unix:/var/run/authd/authd.sock (OpenBSD).
# A bare absolute path is also accepted. Do not use unix:/// URL syntax.
AUTHD_LISTEN='127.0.0.1:8080'

# Unix-only options; leave commented for TCP. Default mode is owner-only 0600.
# Use a dedicated group shared by _authd and the proxy, NOT the _authd group
# that can read authd's environment. See docs/UNIX_SOCKET.md for group creation.
# AUTHD_UNIX_MODE='0660'
# AUTHD_UNIX_GROUP='authd_proxy'
# Trust X-Forwarded-For over actual Unix connections only. The proxy must
# overwrite this header. This does not trust a TCP peer or change cookie/TLS rules.
# AUTHD_TRUST_UNIX_PROXY='true'

# PostgreSQL. Same-host example; remote deployments should use TLS verify-full.
# libpq-style URL consumed by pgx.
DATABASE_URL='postgres://authd_runtime@127.0.0.1:5432/authd?sslmode=disable'
# Standard pgx/libpq password file; preferred over embedding the runtime password in DATABASE_URL.
PGPASSFILE='/etc/authd/pgpass'

# File containing exactly 32 random bytes or base64 text decoding to 32 bytes.
# Used to encrypt reversible secrets such as TOTP seeds and signing private keys.
AUTHD_MASTER_KEY_FILE='/etc/authd/master.key'

# Optional development mode. Requires a loopback issuer and loopback TCP or local Unix listener; uses non-Secure development cookies.
# AUTHD_DEVELOPMENT=true

# These values are read from the process environment, not parsed from this file.

# Optional lifetime defaults. AUTHD_ACCESS_TOKEN_TTL is the default presented
# when registering a new client; each client stores its own access-token TTL.
# AUTHD_ACCESS_TOKEN_TTL=5m
# AUTHD_AUTH_CODE_TTL=1m
# AUTHD_SESSION_IDLE_TTL=12h
# AUTHD_SESSION_ABSOLUTE_TTL=168h
# AUTHD_REFRESH_IDLE_TTL=720h
# AUTHD_REFRESH_ABSOLUTE_TTL=2160h
# AUTHD_CLEANUP_INTERVAL=1h
# AUTHD_AUDIT_RETENTION=8760h
# For TCP, trust X-Forwarded-For only from a direct peer in these CIDRs.
# They may also describe extra upstream TCP hops behind an explicitly trusted Unix proxy.
# AUTHD_TRUSTED_PROXIES=127.0.0.1/32,::1/128
